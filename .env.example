# Copy these into the Vercel project Environment Variables (Production + Preview).
# Never commit real values.

# Required for Cam's voice, speech-to-text, interview turns, and scoring.
XAI_API_KEY=

# Required for accounts, GM board persistence, and cross-device applications.
# Use a Neon pooled Postgres URL (or any Postgres 15+ URL).
DATABASE_URL=

# Better Auth (optional locally; Vercel needs a stable secret in production).
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-domain.vercel.app
